{
  "name": "deck",
  "version": "1.0.0",
  "private": true,
  "description": "An interactive HTML deck built with the PresentToMe starter.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "build:public": "node tools/build.mjs --no-notes --out public-build",
    "dev": "node tools/dev.mjs",
    "check": "node tools/check.mjs",
    "shots": "node tools/check.mjs --shots",
    "shot": "node tools/shot.mjs",
    "fonts": "node tools/fonts.mjs",
    "new": "node tools/new-slide.mjs",
    "scenes": "node tools/scenes.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
